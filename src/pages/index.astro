---
import '@fontsource-variable/mulish';
import '../styles/global.css';
import AppStoreLink from '../components/AppStoreLink.astro';
import PhonePreview from '../components/PhonePreview.astro';

const features = [
  { title: 'Notifications', body: 'Set reminders for sunrise, sunset, first light, and last light.' },
  { title: 'Any city', body: 'Check sun times around the world and save places you visit often.' },
  { title: 'Golden and blue hours', body: 'See when golden hour and blue hour begin and end so you can plan your photography.' },
  { title: 'Widget', body: 'See the next sun event on your home screen.' },
  { title: 'Works offline', body: 'Sun times are calculated on your phone. Saved places work without an internet connection.' },
];
const palettes = [
  { name: 'Classic', colours: '#46eae7, #4a9dcf, #52009f' },
  { name: 'Ember', colours: '#ffc069, #e8765a, #4a1242' },
  { name: 'Midnight', colours: '#8fd8ff, #4e86c9, #141c52' },
  { name: 'Aurora', colours: '#8cf5cd, #35bfa0, #10243e' },
  { name: 'Infrared', colours: '#ff7459, #d93a30, #26060b' },
];
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#397dbc" />
    <title>Solis · Sunrise, sunset, and twilight times</title>
    <meta name="description" content="Sunrise, sunset, and twilight times for iPhone. Track golden and blue hours, save places, and set sun event notifications." />
    <link rel="canonical" href="https://solisapp.xyz/" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Solis · Sunrise, sunset, and twilight times" />
    <meta property="og:description" content="Sunrise, sunset, and twilight times for iPhone." />
    <meta property="og:url" content="https://solisapp.xyz/" />
    <meta property="og:image" content="https://solisapp.xyz/solis-og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Solis. Sunrise, sunset, and twilight times for iPhone." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="google-site-verification" content="Zo8c_JNOJZCRMn0s0_XmXDI55lVUjWvftC4czJMgwi0" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" class="layout container">
      <div class="copy-column">
        <section class="intro" aria-labelledby="title">
          <h1 id="title">Solis</h1>
          <p>Sunrise, sunset, and twilight times for iPhone.</p>
          <AppStoreLink />
        </section>
        <section class="features" id="features" aria-label="Features">
          {features.map((feature) => (
            <article class="feature">
              <h2>{feature.title}</h2>
              <p>{feature.body}</p>
            </article>
          ))}
          <article class="feature">
            <h2>Themes</h2>
            <p>Choose from five colour palettes for the timeline and widget.</p>
            <ul class="palettes" aria-label="Solis colour themes">
              {palettes.map((palette) => <li><span class="palette-swatch" style={`background: linear-gradient(160deg, ${palette.colours})`} aria-hidden="true"></span><span>{palette.name}</span></li>)}
            </ul>
          </article>
        </section>
      </div>
      <aside class="phone-column" aria-label="App screenshots">
        <PhonePreview />
      </aside>
    </main>
    <footer class="site-footer">
      <div class="footer-copy">
        <p>
          Made with <span class="heart">&#9829;&#65038;</span> by <a href="https://jakerunzer.com">jake runzer</a>.<br />
          Source code available on <a href="https://github.com/coffee-cup/solis" target="_blank" rel="noopener">Github</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
